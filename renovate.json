{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>sublimelsp/renovate-preset",
    "github>sublimelsp/renovate-preset:automerge-server"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^plugin\\.py$/"
      ],
      "matchStrings": [
        "VERSION = \"(?<currentValue>.+?)\""
      ],
      "extractVersionTemplate": "v?(?<version>[\\d\\.]*)$",
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "nim-lang/langserver"
    }
  ]
}
