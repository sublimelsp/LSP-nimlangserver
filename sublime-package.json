{
  "contributions": {
    "settings": [
      {
        "file_patterns": [
          "/LSP-nimlangserver.sublime-settings"
        ],
        "schema": {
          "$id": "sublime://settings/LSP-nimlangserver",
          "allOf": [
            {
              "$ref": "sublime://settings/LSP-plugin-base"
            },
            {
              "$ref": "sublime://settings/LSP-nimlangserver#/definitions/PluginConfig"
            }
          ],
          "definitions": {
            "PluginConfig": {
              "properties": {
                "binary": {
                  "type": "string",
                  "default": "nimlangserver",
                  "markdownDescription": "The nimlangserver binary to use.\nIf set to `\"\"`, the server is automatically installed and updated."
                },
                "settings": {
                  "additionalProperties": false,
                  "properties": {
                    "nim.projectMapping": {
                      "description": "Configure how nimsuggest should be started. We don't want nimlangserver to\nstart nimsuggest for each file and this configuration will allow configuring\npair projectFile/fileRegex so that if one of the regexps in the list matches\nthe current file then nimls will use root to start nimsuggest.\nIn case there are no matches nimlangserver will try to guess the most\nsuitable project root.",
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "fileRegex": {
                            "type": "string",
                            "description": "Source file regex."
                          },
                          "projectFile": {
                            "type": "string",
                            "description": "Project file path."
                          }
                        }
                      }
                    },
                    "nim.workingDirectoryMapping": {
                      "type": "array",
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "projectFile": {
                            "type": "string",
                            "description": "Project file path."
                          },
                          "directory": {
                            "type": "string",
                            "description": "Project directory."
                          }
                        }
                      },
                      "description": "🤷‍♂"
                    },
                    "nim.timeout": {
                      "default": 120000,
                      "markdownDescription": "The timeout in ms for `nim.useNimTrack` requests.\nIf not specified the default is 2 minutes.",
                      "type": "number"
                    },
                    "nim.nimsuggestPath": {
                      "default": "",
                      "description": "The path to the nimsuggest. If empty, nimsuggest and nim are looked up on the PATH.",
                      "type": "string"
                    },
                    "nim.autoCheckFile": {
                      "default": false,
                      "description": "Check the file on the fly.",
                      "type": "boolean"
                    },
                    "nim.autoCheckProject": {
                      "default": true,
                      "description": "Enable project checks.",
                      "type": "boolean"
                    },
                    "nim.logNimsuggest": {
                      "type": "boolean",
                      "default": false,
                      "description": "Enable verbose logging of nimsuggest to use profile directory."
                    },
                    "nim.inlayHints.typeHints.enable": {
                      "type": "boolean",
                      "default": true,
                      "description": "Enable inlay type hints."
                    },
                    "nim.inlayHints.parameterHints.enable": {
                      "type": "boolean",
                      "default": true,
                      "description": "Enable inlay parameter hints."
                    },
                    "nim.inlayHints.exceptionHints.enable": {
                      "type": "boolean",
                      "default": false,
                      "description": "Enable inlay hints for exceptions. Disabled by default because enabling them significantly increases the compile time."
                    },
                    "nim.inlayHints.exceptionHints.hintStringLeft": {
                      "type": "string",
                      "default": "🔔",
                      "description": "The string to use for exception hints. This string is displayed to the left of the symbol name."
                    },
                    "nim.inlayHints.exceptionHints.hintStringRight": {
                      "type": "string",
                      "default": "",
                      "description": "The string to use for exception hints. This string is displayed to the right of the symbol name."
                    },
                    "nim.notificationVerbosity": {
                      "type": "string",
                      "default": "info",
                      "enum": [
                        "none",
                        "error",
                        "warning",
                        "info"
                      ],
                      "description": "The verbosity of the Nim language server notifications."
                    },
                    "nim.checkOnSave": {
                      "type": "boolean",
                      "default": true,
                      "markdownDescription": "Check the project on save (requires `nim.autoCheckProject`)."
                    },
                    "nim.formatOnSave": {
                      "type": "boolean",
                      "default": false,
                      "description": "Format the file on save. Requires nph for formatting."
                    },
                    "nim.useNimCheck": {
                      "type": "boolean",
                      "default": false,
                      "description": "Use nim check instead of nimsuggest for linting. Controls lsp backend behavior."
                    },
                    "nim.nimExpandArc": {
                      "type": "boolean",
                      "default": false,
                      "description": "Expand ARC on proc definition hover."
                    },
                    "nim.nimExpandMacro": {
                      "type": "boolean",
                      "default": false,
                      "description": "Expand macro calls on hover."
                    },
                    "nim.maxNimsuggestProcesses": {
                      "type": "number",
                      "default": 0,
                      "description": "The maximum number of nimsuggest processes to keep alive in the lsp. 0 means unlimited."
                    },
                    "nim.nimsuggestIdleTimeout": {
                      "type": "number",
                      "default": 120000,
                      "description": "The timeout in ms after which an idle nimsuggest will be stopped. If not specified the default is 120 seconds."
                    },
                    "nim.nimsuggestTimeout": {
                      "type": "number",
                      "default": 60000,
                      "description": "The timeout in ms for the nimsuggest startup + initial compilation. If not specified the default is 60 seconds."
                    },
                    "nim.nimsuggestMaxMemory": {
                      "type": "number",
                      "default": 4000,
                      "markdownDescription": "Memory cap per nimsuggest process in MB. nimsuggest quits when the value is reached. `0` means unlimited. Default: nimsuggest's own default (4000 MB). Requires a nimsuggest advertising the `maxMemory` capability; ignored otherwise."
                    },
                    "nim.useNimTrack": {
                      "type": "boolean",
                      "default": false,
                      "markdownDescription": "Use `nim track` for goto definition and find usages."
                    },
                  }
                }
              }
            }
          }
        }
      },
      {
        "file_patterns": [
          "/*.sublime-project"
        ],
        "schema": {
          "properties": {
            "settings": {
              "properties": {
                "LSP": {
                  "properties": {
                    "LSP-nimlangserver": {
                      "$ref": "sublime://settings/LSP-nimlangserver#/definitions/PluginConfig"
                    }
                  }
                }
              }
            }
          }
        }
      }
    ]
  }
}